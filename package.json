{
  "name": "reframe-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reframe development workspace",
  "workspaces": [
    "packages/*",
    "demo/*"
  ],
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test:unit": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/unit",
    "test:integration": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/integration",
    "test:performance": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/performance",
    "test:phase0:integration": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/integration/phase-0-fixtures.test.ts tests/integration/phase-0-processes.test.ts",
    "test:phase0:performance": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/performance/phase-0-fixture-copy.test.ts",
    "test:e2e": "playwright test tests/e2e/phase-0-demos.spec.ts",
    "test:phase0": "node scripts/run-phase0-tests.mjs",
    "test:phase1": "node scripts/run-phase1-tests.mjs",
    "test:phase1:integration": "npm run verify:pack",
    "test:phase1:performance": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=60000 --hookTimeout=30000 tests/performance/phase-1-lifecycle.test.ts",
    "test:phase2:integration": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=60000 --hookTimeout=30000 tests/integration/phase-2-project.test.ts",
    "test:phase2:performance": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=60000 --hookTimeout=30000 tests/performance/phase-2-startup.test.ts",
    "test:phase2": "node scripts/run-phase2-tests.mjs",
    "test:phase3:integration": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/integration/phase-3-proxy.test.ts",
    "test:phase3:e2e": "playwright test tests/e2e/phase-3-toolbar.spec.ts",
    "test:phase3:performance": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/performance/phase-3-proxy.test.ts",
    "test:phase3": "node scripts/run-phase3-tests.mjs",
    "test:phase4:integration": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/integration/phase-4-websocket.test.ts",
    "test:phase4:e2e": "playwright test tests/e2e/phase-4-connection.spec.ts",
    "test:phase4:performance": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/performance/phase-4-websocket.test.ts",
    "test:phase4:regression:e2e": "playwright test tests/e2e/phase-3-toolbar.spec.ts --grep \"P3-01|P3-02|P3-09|P3-12\"",
    "test:phase4:regression:ws": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/integration/phase-3-proxy.test.ts -t P3-11",
    "test:phase4:regression:cli": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=60000 --hookTimeout=30000 tests/integration/phase-2-project.test.ts -t SUP-P2-01",
    "test:phase4:regression:pack": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/integration/phase-1-cli.test.ts -t \"P1-01|P1-02\"",
    "test:phase4": "node scripts/run-phase4-tests.mjs",
    "test:phase5:integration": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/integration/phase-5-proposal.test.ts",
    "test:phase5:e2e": "playwright test tests/e2e/phase-5-selection.spec.ts",
    "test:phase5:performance": "playwright test tests/e2e/phase-5-performance.spec.ts",
    "test:phase5:cross-browser": "playwright test tests/e2e/phase-5-selection.spec.ts --grep P5-15 --config playwright.phase5.config.ts",
    "test:phase5:regression": "npm run test:phase4",
    "test:phase5": "node scripts/run-phase5-tests.mjs",
    "test:phase6:integration": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/integration/phase-6-source-editor.test.ts",
    "test:phase6:e2e": "playwright test tests/e2e/phase-6-persistence.spec.ts",
    "test:phase6:performance": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/performance/phase-6-source-write.test.ts",
    "test:phase6:regression": "npm run test:phase5",
    "test:phase6": "node scripts/run-phase6-tests.mjs",
    "test:phase7:integration": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=120000 --hookTimeout=30000 tests/integration/phase-7-history.test.ts",
    "test:phase7:e2e": "playwright test tests/e2e/phase-7-history.spec.ts",
    "test:phase7:performance": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=120000 --hookTimeout=30000 tests/performance/phase-7-history.test.ts",
    "test:phase7:regression": "npm run test:phase6",
    "test:phase7": "node scripts/run-phase7-tests.mjs",
    "test:phase8:integration": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/integration/phase-8-ai-edit.test.ts",
    "test:phase8:e2e": "playwright test tests/e2e/phase-8-ai-edit.spec.ts",
    "test:phase8:performance": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/performance/phase-8-ai-edit.test.ts",
    "test:phase8:regression": "npm run test:phase7:integration && npm run test:phase7:e2e",
    "test:phase9:integration": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/integration/phase-9-design-dna.test.ts",
    "test:phase9:performance": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/performance/phase-9-design-dna.test.ts",
    "test:phase9:regression": "npm run test:phase8:integration && npm run test:phase8:e2e",
    "test:phase10:e2e": "playwright test --config=playwright.phase10.config.ts --project=chromium tests/e2e/phase-10-time-machine.spec.ts",
    "test:phase10:cross-browser": "playwright test --config=playwright.phase10.config.ts --grep P10-13 tests/e2e/phase-10-time-machine.spec.ts",
    "test:phase10:regression": "npm run test:phase9:integration && npm run test:phase8:e2e && npm run test:phase7:e2e",
    "test:phase11:integration": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/integration/phase-11-annotations.test.ts",
    "test:phase11:e2e": "playwright test --config=playwright.phase10.config.ts --project=chromium tests/e2e/phase-11-comments.spec.ts",
    "test:phase11:performance": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=60000 tests/performance/phase-11-annotations.test.ts",
    "test:phase11:regression": "npm run test:phase10:e2e && npm run test:phase10:regression && npm run test:phase4:integration && npm run test:phase2:integration",
    "test:phase11": "npm run build && npm run test:phase11:integration && npm run test:phase11:e2e && npm run test:phase11:performance",
    "test:phase12:integration": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/integration/phase-12-reference-adaptation.test.ts",
    "test:phase12:e2e": "playwright test --config=playwright.phase10.config.ts --project=chromium tests/e2e/phase-12-reference-adaptation.spec.ts",
    "test:phase12:performance": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/performance/phase-12-reference-adaptation.test.ts",
    "test:phase12:regression": "npm run test:unit && npm run test:phase0:integration && npm run test:phase0:performance && npm run test:e2e && npm run test:phase1:integration && npm run test:phase1:performance && npm run test:phase2:integration && npm run test:phase2:performance && npm run test:phase3:integration && npm run test:phase3:e2e && npm run test:phase3:performance && npm run test:phase4:integration && npm run test:phase4:e2e && npm run test:phase4:performance && npm run test:phase5:integration && npm run test:phase5:e2e && npm run test:phase5:performance && npm run test:phase5:cross-browser && npm run test:phase6:integration && npm run test:phase6:e2e && npm run test:phase6:performance && npm run test:phase7:integration && npm run test:phase7:e2e && npm run test:phase7:performance && npm run test:phase8:integration && npm run test:phase8:e2e && npm run test:phase8:performance && npm run test:phase9:integration && npm run test:phase9:performance && npm run test:phase10:e2e && npm run test:phase10:cross-browser && npm run test:phase11:integration && npm run test:phase11:e2e && npm run test:phase11:performance",
    "test:phase12": "npm run build && npm run test:phase12:integration && npm run test:phase12:e2e && npm run test:phase12:performance",
    "pack:cli": "node scripts/pack-cli.mjs",
    "website:serve": "npx --yes serve website -p 4173",
    "website:build-client": "node scripts/build-website-client.mjs",
    "website:prepare": "npm run build && npm run website:build-client",
    "verify:pack": "vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 tests/integration/phase-1-cli.test.ts",
    "verify:phase1-leaks": "node scripts/verify-no-process-leaks.mjs 4400",
    "verify:phase2-leaks": "node scripts/verify-no-process-leaks.mjs 4400 5173",
    "verify:phase3-leaks": "node scripts/verify-no-process-leaks.mjs 4400 5173",
    "verify:phase7-leaks": "node scripts/verify-no-process-leaks.mjs 4400 5173",
    "verify:fixtures": "vitest run tests/unit/phase-0-manifests.test.ts",
    "verify:leaks": "node scripts/verify-no-process-leaks.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
